# Copy to .env for local development (values match docker-compose.yml).
# Leave DATABASE_URL unset to use the in-memory user store instead of Postgres.
DATABASE_URL="postgresql://aster:aster_dev_password@localhost:5432/aster_horoscope?schema=public"

# YouTube Data API v3 key (Google Cloud Console -> enable "YouTube Data API v3" -> Credentials).
# Optional: without it, Aster School video lessons still work but skip live view counts.
YOUTUBE_API_KEY=

# Optional: dedicated Sepolia RPC endpoint (Alchemy/Infura/thirdweb, etc.) used
# for on-chain token balance/staking reads. Without it, wagmi falls back to a
# shared public RPC that can rate-limit and cause balances to fail to load.
NEXT_PUBLIC_SEPOLIA_RPC_URL=

# Private key (0x-prefixed) of the server-held treasury wallet that pays out
# quest rewards: a random 1-100 HAPPY_COIN transfer to the Seeker's linked
# wallet on verified mission completion. That wallet must hold enough
# HAPPY_COIN and Sepolia ETH (for gas) to cover payouts. Without this set,
# missions still complete and reward values still roll — the on-chain
# transfer is just skipped (recorded as a payoutError) until it's configured.
# NEVER commit the real key; set it directly in Vercel/your local .env only.
REWARD_TREASURY_PRIVATE_KEY=
