// Prisma schema — user/auth persistence (PostgreSQL).
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A registered player. Passwords are stored hashed (never plaintext).
model User {
  id            String         @id @default(uuid())
  username      String         @unique
  passwordHash  String
  /// Linked EVM wallet address (lowercase), optional alternate login credential.
  walletAddress String?        @unique
  createdAt     DateTime       @default(now())
  history       HistoryEntry[]

  @@map("users")
}

/// A completed-mission record: the picked card, the quest (feature) it assigned,
/// the reward granted, and when. Owned by the server; one row per completion.
model HistoryEntry {
  id            String   @id @default(uuid())
  userId        String
  cardRef       String
  featureRef    String
  difficulty    String
  rewardType    String?
  rewardValue   Int?
  rewardGranted Boolean  @default(false)
  /// On-chain HAPPY_COIN transfer hash for this reward, or null if not paid out.
  payoutTxHash  String?
  completedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, completedAt])
  @@map("history_entries")
}

/// An online Werewolf game room. No user account required — players are
/// identified by a per-player secret token minted at join time. The entire
/// mutable game state (players, phase, night picks, votes) lives in one JSON
/// blob per room so the whole state machine stays in a single row; traffic
/// per room is tiny (a handful of players polling every couple seconds), so
/// this trades strict concurrency control for simplicity.
model WerewolfRoom {
  id        String   @id @default(uuid())
  /// Short shareable join code (e.g. "7F3KQ2"), unique while the room lives.
  code      String   @unique
  state     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("werewolf_rooms")
}

/// A Tarot Match ranking-board result: player name, score (fewer moves is
/// better) and when it was set. Public board — not user-scoped.
model MatchScore {
  id        String   @id @default(uuid())
  name      String
  moves     Int
  createdAt DateTime @default(now())

  @@index([moves, createdAt])
  @@map("match_scores")
}

/// Aster School — a community knowledge lesson: a written article (markdown),
/// an uploaded PDF, or a linked video. Public to read; authored by a signed-in user.
model Lesson {
  id          String     @id @default(uuid())
  authorId    String
  authorName  String
  title       String
  summary     String?
  type        String // "article" | "pdf" | "video"
  content     String? // markdown (articles)
  pdfFileName String?
  videoUrl    String? // YouTube link (video)
  videoAuthor String? // YouTube channel name, fetched when the link is attached
  tags        String[]   @default([])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  file          LessonFile?
  comments      Comment[]
  reactions     Reaction[]
  playlistItems PlaylistItem[]

  @@index([authorId])
  @@index([createdAt])
  @@map("lessons")
}

/// The bytes of an uploaded PDF (kept in its own table so lesson listings
/// never load the blob). Served inline via the lesson file endpoint.
model LessonFile {
  id        String   @id @default(uuid())
  lessonId  String   @unique
  data      Bytes
  createdAt DateTime @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("lesson_files")
}

/// An image attached inline into a lesson's markdown body via the rich text
/// editor. Not tied to a lesson row — images upload before the lesson (which
/// may not exist yet) is saved, and are referenced by URL from the markdown.
model Asset {
  id        String   @id @default(uuid())
  authorId  String
  data      Bytes
  mimeType  String
  createdAt DateTime @default(now())

  @@index([authorId])
  @@map("assets")
}

/// A comment on a lesson.
model Comment {
  id         String   @id @default(uuid())
  lessonId   String
  authorId   String
  authorName String
  body       String
  createdAt  DateTime @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId, createdAt])
  @@map("comments")
}

/// A like/bookmark reaction on a lesson (one per user per type).
model Reaction {
  id        String   @id @default(uuid())
  lessonId  String
  userId    String
  type      String // "like" | "bookmark"
  createdAt DateTime @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, userId, type])
  @@map("reactions")
}

/// A user-curated, ordered collection of video lessons — "watch these in order."
model Playlist {
  id            String   @id @default(uuid())
  authorId      String
  authorName    String
  title         String
  description   String?
  /// Uploaded cover image URL (e.g. /api/v1/school/assets/:id); falls back to
  /// the first video's thumbnail in the UI when unset.
  coverImageUrl String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items PlaylistItem[]

  @@index([authorId])
  @@index([createdAt])
  @@map("playlists")
}

/// One video lesson's slot within a playlist, in play order.
model PlaylistItem {
  id         String   @id @default(uuid())
  playlistId String
  lessonId   String
  position   Int
  createdAt  DateTime @default(now())

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  lesson   Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([playlistId, lessonId])
  @@index([playlistId, position])
  @@map("playlist_items")
}
